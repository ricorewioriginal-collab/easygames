# Kopieren nach .env und ausfüllen. .env niemals einchecken.
# Pflicht: zufälliges Secret für öffentliche Spieler-Kennungen (HMAC), z. B.:  openssl rand -hex 32
TARGET_SECRET=
# Firebase-Projekt, dessen ID-Tokens akzeptiert werden
FIREBASE_PROJECT_ID=ricorewi-games-save
# Erlaubte Browser-Origins (kommagetrennt, ohne Pfad)
ALLOWED_ORIGINS=https://ricorewioriginal-collab.github.io
# Hinter Cloud Run / Reverse-Proxy: echte Client-IP aus X-Forwarded-For für das IP-Rate-Limit
TRUST_PROXY=1
# Optional
# PORT=8080
# HOST=0.0.0.0
# DATA_DIR=/data
# SPINWELTEN_GAME_DIR=../spinwelten
# AUTH_MODE=firebase   (AUTH_MODE=test nur zusammen mit NODE_ENV=test, sonst Startabbruch)
