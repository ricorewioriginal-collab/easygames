{
  "name": "partyverse",
  "version": "1.0.0",
  "private": true,
  "description": "PARTYVERSE – 3D-Brettspiel-Partyspiel mit 50 Layouts, 22 Minispielen und Online-Multiplayer (Colyseus)",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "npm run typecheck && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "server": "tsx --tsconfig tsconfig.server.json server/src/index.ts",
    "server:build": "esbuild server/src/index.ts --bundle --platform=node --format=esm --packages=external --tsconfig=tsconfig.server.json --outfile=server/dist/server.mjs",
    "server:start": "node server/dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@colyseus/schema": "2.0.37",
    "@colyseus/ws-transport": "0.15.3",
    "colyseus": "0.15.57",
    "colyseus.js": "0.15.28",
    "express": "4.21.2",
    "jsqr": "1.4.0",
    "qrcode-generator": "1.4.4",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "@types/three": "0.170.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "9.1.0",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.2",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
