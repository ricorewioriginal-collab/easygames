# Client (Vite): Basis-URL des gebauten Spiels (Standard './' – funktioniert in jedem Unterordner)
# VITE_BASE=/easygames/partyverse/app/
# Client (Vite): Adresse des Colyseus-Servers (ws:// oder wss://). Ohne Angabe ist der Online-Modus deaktiviert,
# bis der Spieler im Menü eine Server-Adresse einträgt. Lokale Partien und Bots brauchen keinen Server.
# VITE_SERVER_URL=ws://localhost:2567

# Server
# PORT=2567
# ALLOWED_ORIGINS=https://deinname.github.io
