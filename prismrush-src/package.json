{
  "name": "prismrush",
  "version": "1.0.0",
  "private": true,
  "description": "PRISMRUSH – hypnotisches 3D-Rhythmusspiel für Browser und Mobilgeräte (TypeScript, Three.js, Web Audio).",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "check": "npm run lint && npm run format:check && npm run test && npm run build && npm run test:e2e",
    "build:easygames": "npm run build && rm -rf ../prismrush && cp -r dist ../prismrush"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.18.8",
    "@types/three": "^0.180.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
