{
  "name": "bunte-insel-2",
  "version": "2.0.0",
  "private": true,
  "description": "Bunte Insel 2 – farbenfrohes 3D-Fantasy-Abenteuer, Nachfolger von Bunte Insel (EasyGames).",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:offline": "tsc --noEmit && node scripts/build.mjs",
    "deploy": "node scripts/deploy.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --test tests/*.test.mjs",
    "test:e2e": "node e2e/run.mjs",
    "check": "npm run typecheck && npm test && npm run build:offline && npm run deploy && npm run test:e2e",
    "test:renewal": "node e2e/renewal.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vite": "^7.1.12",
    "playwright": "^1.56.0",
    "esbuild": "^0.25.0"
  }
}
