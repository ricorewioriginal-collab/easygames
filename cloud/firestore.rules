rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Jeder angemeldete Spieler darf nur seine eigenen Spielstände lesen und schreiben.
    match /users/{uid}/saves/{game} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['d', 't'])
        && request.resource.data.d is string
        && request.resource.data.d.size() < 950000;
      allow delete: if false;
    }
    // Ranglisten (nur mit Freigabe des Spielers, siehe cloud/anmacha-board.js): öffentlich lesbar; jeder darf nur seinen EIGENEN Eintrag
    // schreiben (Dokument-ID = eigene uid), nur mit Spitzname + Wert, ein bestehender Eintrag darf nur besser werden und jederzeit gelöscht werden.
    function boardEntryOk(d) {
      return d.keys().hasOnly(['n', 's', 'o', 't'])
        && d.n is string && d.n.size() >= 2 && d.n.size() <= 20
        && d.s is number && d.s >= 0 && d.s <= 1000000000000
        && d.o in ['asc', 'desc']
        && d.t is int;
    }
    match /boards/{board}/e/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
        && board.matches('^[A-Za-z0-9_-]{1,60}$')
        && boardEntryOk(request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid
        && boardEntryOk(request.resource.data)
        && request.resource.data.o == resource.data.o
        && ((request.resource.data.o == 'desc' && request.resource.data.s >= resource.data.s)
          || (request.resource.data.o == 'asc' && request.resource.data.s <= resource.data.s));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Kopplung der Apps (Android/Windows): Die Browserseite legt nach der Google-Anmeldung einen Eintrag unter einem
    // 128-Bit-Zufallscode an, die App liest ihn genau einmal (Code kennt nur die App) und löscht ihn wieder. Kein Auflisten.
    match /pair/{code} {
      allow get, delete: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['rt', 't'])
        && request.resource.data.rt is string
        && request.resource.data.rt.size() < 2000;
      allow list, update: if false;
    }
  }
}
