rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Jeder angemeldete Spieler darf nur seine eigenen Spielstände lesen und schreiben.
    match /users/{uid}/saves/{game} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['d', 't'])
        && request.resource.data.d is string
        && request.resource.data.d.size() < 950000;
      allow delete: if request.auth != null && request.auth.uid == uid;   // nur für die Konto-Löschung (konto-loeschen.html): eigene alte Sicherungen entfernen
    }
    // Ranglisten (nur mit Freigabe des Spielers, siehe cloud/anmacha-board.js): öffentlich lesbar; jeder darf nur seinen EIGENEN Eintrag
    // schreiben (Dokument-ID = eigene uid), nur mit Spitzname + Wert, ein bestehender Eintrag darf nur besser werden und jederzeit gelöscht werden.
    function boardEntryOk(d) {
      return d.keys().hasOnly(['n', 's', 'o', 't'])
        && d.n is string && d.n.size() >= 2 && d.n.size() <= 20
        && d.s is number && d.s >= 0 && d.s <= 1000000000000
        && d.o in ['asc', 'desc']
        && d.t is int;
    }
    match /boards/{board}/e/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
        && board.matches('^[A-Za-z0-9_-]{1,60}$')
        && boardEntryOk(request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid
        && boardEntryOk(request.resource.data)
        && request.resource.data.o == resource.data.o
        && ((request.resource.data.o == 'desc' && request.resource.data.s >= resource.data.s)
          || (request.resource.data.o == 'asc' && request.resource.data.s <= resource.data.s));
      allow delete: if request.auth != null && (request.auth.uid == uid || chatAdmin());   // Betreiber darf unpassende Einträge entfernen (Verwaltung)
    }
    // Kopplung der Apps (Android/Windows): Die Browserseite legt nach der Google-Anmeldung einen Eintrag unter einem
    // 128-Bit-Zufallscode an, die App liest ihn genau einmal (Code kennt nur die App) und löscht ihn wieder. Kein Auflisten.
    match /pair/{code} {
      allow get, delete: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['rt', 't'])
        && request.resource.data.rt is string
        && request.resource.data.rt.size() < 2000;
      allow list, update: if false;
    }
    // ---- RicoVille-Nachbarn (Spark-Tarif, ohne Server). Der Schutz liegt allein in diesen Regeln:
    //  - Jeder schreibt nur seine eigene Stadtansicht und seine eigene Nachbarliste.
    //  - In fremde Posteingänge passen nur kleine, fest geformte Nachrichten: höchstens eine je Absender, Art und Tag
    //    (Dokument-ID = Absender_Tag_Art; Ändern und Löschen am selben Tag ist verboten).
    //  - Der Empfänger darf eine Nachricht nur als erledigt markieren und erst ab dem Folgetag löschen.
    //  Tests: ricoville-src/firebase (npm test, lokaler Emulator).
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // Heutiger Tag in UTC als Zahl JJJJMMTT (dieselbe Rechnung macht das Spiel)
    function today() { return request.time.year() * 10000 + request.time.month() * 100 + request.time.day(); }
    function shortText(v, max) { return v is string && v.size() <= max; }

    // Öffentliche Kurzansicht einer Stadt: angemeldete Spieler können sie ansehen (besuchen) und die neuesten auflisten.
    match /ricoville_cities/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 30;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['v', 'name', 'crest', 'slogan', 'level', 'pop', 't', 'layout'])
        && request.resource.data.keys().hasAll(['v', 'name', 'level', 'pop', 't', 'layout'])
        && request.resource.data.v == 1
        && shortText(request.resource.data.name, 24) && request.resource.data.name.size() > 0
        && (!('crest' in request.resource.data) || shortText(request.resource.data.crest, 8))
        && (!('slogan' in request.resource.data) || shortText(request.resource.data.slogan, 60))
        && request.resource.data.level is int && request.resource.data.level >= 1 && request.resource.data.level <= 999
        && request.resource.data.pop is int && request.resource.data.pop >= 0 && request.resource.data.pop <= 1000000
        && request.resource.data.t is int
        && shortText(request.resource.data.layout, 60000);
      allow delete: if isOwner(uid);

      // Eigene Nachbarliste (nur der Besitzer sieht und ändert sie)
      match /neighbors/{nid} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && nid != uid
          && request.resource.data.keys().hasOnly(['name', 't'])
          && shortText(request.resource.data.name, 24)
          && request.resource.data.t is int;
      }

      // Posteingang: Besuch, Geschenk oder „Hallo, Nachbar!"
      match /inbox/{mid} {
        allow read: if isOwner(uid);
        allow create: if signedIn() && request.auth.uid != uid
          && exists(/databases/$(database)/documents/ricoville_cities/$(uid))
          && request.resource.data.keys().hasOnly(['from', 'name', 'type', 'day', 'item', 'n', 'done'])
          && request.resource.data.keys().hasAll(['from', 'name', 'type', 'day', 'done'])
          && request.resource.data.from == request.auth.uid
          && shortText(request.resource.data.name, 24)
          && request.resource.data.type in ['visit', 'gift', 'hello']
          && request.resource.data.day == today()
          && request.resource.data.done == false
          && mid == request.auth.uid + '_' + string(today()) + '_' + request.resource.data.type
          && (request.resource.data.type == 'gift'
                ? request.resource.data.item in ['bretter', 'ziegel', 'glas', 'stahl', 'holz']
                : !('item' in request.resource.data))
          && (request.resource.data.type == 'visit'
                ? request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= 5
                : !('n' in request.resource.data));
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done'])
          && request.resource.data.done == true;
        allow delete: if isOwner(uid) && resource.data.day < today();
      }
    }

    // ---------- RicoPoly 3D (ricopoly/js/fire.js) ----------
    // Weltweite Rangliste: ein Eintrag je Konto (auch anonym), nur der Besitzer schreibt. Jede Partie zählt
    // höchstens einmal pro Minute und erhöht Partien um genau 1 und Siege um 0 oder 1.
    match /ricopoly_board/{uid} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit <= 50;
      allow create: if request.auth != null && request.auth.uid == uid && rpBoard(request.resource.data)
        && request.resource.data.g == 1 && request.resource.data.w <= 1;
      allow update: if request.auth != null && request.auth.uid == uid && rpBoard(request.resource.data)
        && request.resource.data.g == resource.data.g + 1
        && request.resource.data.w >= resource.data.w && request.resource.data.w <= resource.data.w + 1
        && request.time > resource.data.t + duration.value(60, 's');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    function rpBoard(d) {
      return d.keys().hasOnly(['n', 'c', 'w', 'g', 't']) && d.keys().hasAll(['n', 'c', 'w', 'g', 't'])
        && d.n is string && d.n.size() > 0 && d.n.size() <= 24 && d.c is string && d.c.size() <= 16
        && d.w is int && d.g is int && d.w >= 0 && d.w <= d.g && d.t == request.time;
    }

    // Online-Räume: Firebase vermittelt nur den Verbindungsaufbau (WebRTC-Angebot/Antwort), gespielt wird direkt.
    // Ein Raum gehört seinem Gastgeber; private Räume lassen sich nicht auflisten (Schutz ist der Code).
    match /ricopoly_rooms/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && code.matches('^[A-Z0-9]{6}$') && rpRoom(request.resource.data);
      allow update: if request.auth != null && resource.data.h == request.auth.uid && rpRoom(request.resource.data);
      allow delete: if request.auth != null && resource.data.h == request.auth.uid;

      // Beitritt: Der Gast legt sein Angebot unter seiner Konto-Kennung ab, nur der Gastgeber trägt die Antwort ein.
      match /join/{uid} {
        allow get: if request.auth != null && (request.auth.uid == uid || rpHost(code));
        allow list: if request.auth != null && request.query.limit <= 20 && rpHost(code);
        allow create, update: if request.auth != null && request.auth.uid == uid
          && exists(/databases/$(database)/documents/ricopoly_rooms/$(code))
          && request.resource.data.keys().hasOnly(['o', 'a', 't']) && request.resource.data.keys().hasAll(['o', 'a', 't'])
          && request.resource.data.o is string && request.resource.data.o.size() < 20000
          && request.resource.data.a == '' && request.resource.data.t == request.time;
        allow update: if request.auth != null && rpHost(code)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['a', 't'])
          && request.resource.data.a is string && request.resource.data.a.size() < 20000 && request.resource.data.t == request.time;
        allow delete: if request.auth != null && (request.auth.uid == uid || rpHost(code));
      }
    }
    function rpRoom(d) {
      return d.keys().hasOnly(['h', 't']) && d.h == request.auth.uid && d.t == request.time;
    }
    function rpHost(code) {
      return get(/databases/$(database)/documents/ricopoly_rooms/$(code)).data.h == request.auth.uid;
    }
    // Öffentliche Räume: kleine Liste mit Name, Welt, Modus und Belegung, nur vom Gastgeber des Raums gepflegt.
    match /ricopoly_pub/{code} {
      allow list: if request.auth != null && request.query.limit <= 20;
      allow get: if request.auth != null;
      allow create, update: if request.auth != null && rpHost(code)
        && request.resource.data.keys().hasOnly(['h', 'n', 'w', 'm', 'c', 'x', 't']) && request.resource.data.h == request.auth.uid
        && request.resource.data.n is string && request.resource.data.n.size() <= 24
        && request.resource.data.w in ['metropolis', 'fantasy', 'future'] && request.resource.data.m in ['classic', 'quick', 'custom']
        && request.resource.data.c is int && request.resource.data.x is int && request.resource.data.t == request.time;
      allow delete: if request.auth != null && resource.data.h == request.auth.uid;
    }

    // ---------- AnMaCha UNDERCOVER 3D: öffentliche Räume (anmacha-undercover/src/network/public-rooms.js) ----------
    // undercover_pub/<CODE>: nur der Gastgeber des Raums (Besitzer von p2p/amu-<CODE>) schreibt Name, Modus und Belegung.
    match /undercover_pub/{code} {
      allow list: if request.auth != null && request.query.limit <= 20;
      allow get: if request.auth != null;
      allow create, update: if request.auth != null && code.matches('^[A-HJKMNP-Z2-9]{5}$')
        && get(/databases/$(database)/documents/p2p/$('amu-' + code)).data.h == request.auth.uid
        && request.resource.data.keys().hasOnly(['h', 'n', 'm', 'c', 'x', 't']) && request.resource.data.h == request.auth.uid
        && request.resource.data.n is string && request.resource.data.n.size() <= 24
        && request.resource.data.m in ['jagd', 'wort', 'detektiv', 'chaos', 'jagen', 'rollen']
        && request.resource.data.c is int && request.resource.data.x is int && request.resource.data.c >= 0 && request.resource.data.x <= 12
        && request.resource.data.t == request.time;
      allow delete: if request.auth != null && resource.data.h == request.auth.uid;
    }

    // ---------- easygames-Chat (chat.html, nur für angemeldete Spieler) ----------
    // Nachrichten chat/<raum>/m/<id>: u = eigene uid, n = Spitzname, x = Text (1–200 Zeichen), t = Serverzeit. Lesen nur angemeldet.
    // Flutschutz auf dem Server: Jede Nachricht muss im selben Schreibvorgang chat_last/<uid> auf die Serverzeit setzen, und das geht
    // höchstens alle 2 Sekunden. Gesperrte Spieler (chat_ban/<uid>) können nicht schreiben. Löschen: Autor oder Betreiber.
    // Betreiber = das Google-Konto ricorewioriginal@gmail.com (bestätigte E-Mail im Anmelde-Token) oder, zusätzlich, ein Dokument chat_admin/<uid>
    // (nur in der Firebase-Konsole anlegen). Meldungen (chat_reports, bugs) und Sperren (chat_ban) pflegt nur der Betreiber.
    function chatAdmin() {
      return signedIn() && ((request.auth.token.email == 'ricorewioriginal@gmail.com' && request.auth.token.email_verified == true)
        || exists(/databases/$(database)/documents/chat_admin/$(request.auth.uid)));
    }
    match /chat/{room}/m/{mid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 60;
      allow create: if signedIn() && room.matches('^[a-z0-9-]{1,40}$')
        && request.resource.data.keys().hasOnly(['u', 'n', 'x', 't']) && request.resource.data.keys().hasAll(['u', 'n', 'x', 't'])
        && request.resource.data.u == request.auth.uid
        && request.resource.data.n is string && request.resource.data.n.size() >= 2 && request.resource.data.n.size() <= 20
        && request.resource.data.x is string && request.resource.data.x.size() >= 1 && request.resource.data.x.size() <= 200
        && request.resource.data.t == request.time
        && !exists(/databases/$(database)/documents/chat_ban/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/chat_last/$(request.auth.uid)).data.t == request.time;
      allow update: if false;
      allow delete: if chatAdmin() || (signedIn() && resource.data.u == request.auth.uid);
    }
    match /chat_last/{uid} {
      allow create: if isOwner(uid) && request.resource.data.keys().hasOnly(['t']) && request.resource.data.t == request.time;
      allow update: if isOwner(uid) && request.resource.data.keys().hasOnly(['t']) && request.resource.data.t == request.time
        && request.time > resource.data.t + duration.value(2, 's');
      allow read, delete: if false;
    }
    // Wer ist gerade im Chat: ein Dokument je Spieler, Lebenszeichen höchstens alle 20 Sekunden
    match /chat_online/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 60;
      allow create: if isOwner(uid) && request.resource.data.keys().hasOnly(['n', 't'])
        && request.resource.data.n is string && request.resource.data.n.size() >= 2 && request.resource.data.n.size() <= 20 && request.resource.data.t == request.time;
      allow update: if isOwner(uid) && request.resource.data.keys().hasOnly(['n', 't'])
        && request.resource.data.n is string && request.resource.data.n.size() >= 2 && request.resource.data.n.size() <= 20 && request.resource.data.t == request.time
        && request.time > resource.data.t + duration.value(20, 's');
      allow delete: if isOwner(uid);
    }
    match /chat_admin/{uid} {
      allow get: if isOwner(uid);
      allow list, write: if false;
    }
    match /chat_ban/{uid} {
      allow get: if isOwner(uid) || chatAdmin();
      allow create, update, delete: if chatAdmin();
      allow list: if chatAdmin();
    }
    // Meldungen: jeder Angemeldete darf melden (je Meldung ein Dokument), lesen nur der Betreiber
    match /chat_reports/{rid} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['room', 'm', 'u', 'x', 'r', 't'])
        && request.resource.data.r == request.auth.uid
        && request.resource.data.room is string && request.resource.data.room.size() <= 40
        && request.resource.data.m is string && request.resource.data.m.size() <= 40
        && request.resource.data.u is string && request.resource.data.u.size() <= 128
        && request.resource.data.x is string && request.resource.data.x.size() <= 200
        && request.resource.data.t == request.time;
      allow read, delete: if chatAdmin();
      allow update: if false;
    }

    // ---------- Fehlermeldungen (bug.html) ----------
    // bugs/<id>: u = eigene uid, g = Spiel, c = Art, x = Beschreibung (10–1000 Zeichen), i = technische Angaben (JSON, optional), p = Seite (optional), t = Serverzeit.
    // Nur angemeldet und nicht gesperrt, höchstens eine Meldung alle 30 Sekunden (Pflicht-Schreibvorgang auf bug_last/<uid>). Lesen, Abhaken, Löschen: nur der Betreiber (Konto ricorewioriginal@gmail.com oder chat_admin/<uid>).
    match /bugs/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['u', 'g', 'c', 'x', 'i', 'p', 't']) && request.resource.data.keys().hasAll(['u', 'g', 'c', 'x', 't'])
        && request.resource.data.u == request.auth.uid
        && request.resource.data.g is string && request.resource.data.g.size() <= 40
        && request.resource.data.c in ['absturz', 'anzeige', 'steuerung', 'ton', 'online', 'speichern', 'sonstiges']
        && request.resource.data.x is string && request.resource.data.x.size() >= 10 && request.resource.data.x.size() <= 1000
        && (!('i' in request.resource.data) || (request.resource.data.i is string && request.resource.data.i.size() <= 600))
        && (!('p' in request.resource.data) || (request.resource.data.p is string && request.resource.data.p.size() <= 200))
        && request.resource.data.t == request.time
        && !exists(/databases/$(database)/documents/chat_ban/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/bug_last/$(request.auth.uid)).data.t == request.time;
      allow read, update, delete: if chatAdmin();
    }
    match /bug_last/{uid} {
      allow create: if isOwner(uid) && request.resource.data.keys().hasOnly(['t']) && request.resource.data.t == request.time;
      allow update: if isOwner(uid) && request.resource.data.keys().hasOnly(['t']) && request.resource.data.t == request.time
        && request.time > resource.data.t + duration.value(30, 's');
      allow read, delete: if false;
    }

    // ---------- Spiele-Verwaltung (verwaltung.html, im AnMaCha Control Center eingebettet) ----------
    // config/games {d: JSON-Text, t}: Spiele ausblenden / Wartungshinweise für die Spieleliste. Öffentlich lesbar (die Liste holt es beim Laden), schreiben nur der Betreiber.
    match /config/{doc} {
      allow get: if true;
      allow list: if false;
      allow create, update: if chatAdmin() && doc.matches('^[a-z0-9_-]{1,40}$')
        && request.resource.data.keys().hasOnly(['d', 't'])
        && request.resource.data.d is string && request.resource.data.d.size() < 20000 && request.resource.data.t is int;
      allow delete: if chatAdmin();
    }

    // ---------- Nutzungsstatistik (nur angemeldete Spieler, nur Zähler) ----------
    // stats/<spiel>_<JJJJMMTT>_<uid> {g, d, s, t, a, l}: je Spieler, Spiel und Tag Sitzungen s, Spielsekunden t, kurze Sitzungen a (unter 20 s = „Abbruch“) und Zeit der letzten Meldung l.
    // Der Spieler liest und schreibt nur sein eigenes Zähler-Dokument (Kennung endet auf die eigene uid); eine Meldung erhöht s um höchstens 1 (neue Sitzung) und t um 5–3600, höchstens alle 20 Sekunden.
    // Keine Namen, keine Spielstände. Die Auswertung (Summen je Spiel) liest nur der Betreiber.
    function ownStat(id) { return signedIn() && id.matches('^[a-z0-9_-]{1,60}_[0-9]{8}_' + request.auth.uid + '$'); }
    match /stats/{id} {
      allow get: if ownStat(id) || chatAdmin();
      allow list: if chatAdmin();
      allow delete: if chatAdmin();
      allow create: if ownStat(id)
        && request.resource.data.keys().hasOnly(['g', 'd', 's', 't', 'a', 'l']) && request.resource.data.keys().hasAll(['g', 'd', 's', 't', 'a', 'l'])
        && request.resource.data.g is string && request.resource.data.g.size() >= 1 && request.resource.data.g.size() <= 50
        && request.resource.data.d is int && id == request.resource.data.g + '_' + string(request.resource.data.d) + '_' + request.auth.uid
        && request.resource.data.s == 1 && request.resource.data.t is int && request.resource.data.t >= 5 && request.resource.data.t <= 3600
        && request.resource.data.a in [0, 1] && request.resource.data.l == request.time;
      allow update: if ownStat(id)
        && request.resource.data.keys().hasOnly(['g', 'd', 's', 't', 'a', 'l'])
        && request.resource.data.g == resource.data.g && request.resource.data.d == resource.data.d
        && request.resource.data.s is int && request.resource.data.s >= resource.data.s && request.resource.data.s <= resource.data.s + 1
        && request.resource.data.t is int && request.resource.data.t >= resource.data.t + 5 && request.resource.data.t <= resource.data.t + 3600
        && request.resource.data.a is int && request.resource.data.a >= resource.data.a && request.resource.data.a <= resource.data.a + 1
        && request.resource.data.l == request.time && request.time > resource.data.l + duration.value(20, 's');
    }

    // ---------- Tagesherausforderung (heute.html) ----------
    // daily/<JJJJMMTT>/e/<uid> {n, s, o, g, t}: „heute dabei“ mit Bestwert im Tagesspiel (nur mit Freigabe/Spitzname). Ein Eintrag je Spieler und Tag, nur der Besitzer schreibt,
    // ein bestehender Eintrag darf nur besser werden. Lesen nur angemeldet.
    function dailyOk(d) {
      return d.keys().hasOnly(['n', 's', 'o', 'g', 't']) && d.keys().hasAll(['n', 's', 'o', 'g', 't'])
        && d.n is string && d.n.size() >= 2 && d.n.size() <= 20
        && d.s is number && d.s >= 0 && d.s <= 1000000000000
        && d.o in ['asc', 'desc'] && d.g is string && d.g.size() >= 1 && d.g.size() <= 40 && d.t == request.time;
    }
    match /daily/{day}/e/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 50;
      allow create: if isOwner(uid) && day.matches('^[0-9]{8}$') && dailyOk(request.resource.data);
      allow update: if isOwner(uid) && dailyOk(request.resource.data)
        && request.resource.data.g == resource.data.g && request.resource.data.o == resource.data.o
        && ((request.resource.data.o == 'desc' && request.resource.data.s >= resource.data.s)
          || (request.resource.data.o == 'asc' && request.resource.data.s <= resource.data.s));
      allow delete: if isOwner(uid) || chatAdmin();
    }

    // ---------- Profil, Freunde, Einladungen (profil.html) ----------
    // profiles/<uid> {n, e, r, p, a, g, t}: freiwillig veröffentlichtes Profil (Spitzname, Emoji, Rang, Punkte, Erfolge, Lieblingsspiele). Nur einzeln abrufbar (kein Auflisten), nur der Besitzer schreibt
    // (höchstens alle 5 Sekunden), Betreiber darf entfernen.
    match /profiles/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isOwner(uid) && profileOk(request.resource.data);
      allow update: if isOwner(uid) && profileOk(request.resource.data) && request.time > resource.data.t + duration.value(5, 's');
      allow delete: if isOwner(uid) || chatAdmin();
    }
    function profileOk(d) {
      return d.keys().hasOnly(['n', 'e', 'r', 'p', 'a', 'g', 't']) && d.keys().hasAll(['n', 'e', 't'])
        && d.n is string && d.n.size() >= 2 && d.n.size() <= 20
        && d.e is string && d.e.size() <= 8
        && (!('r' in d) || (d.r is string && d.r.size() <= 24))
        && (!('p' in d) || (d.p is int && d.p >= 0 && d.p <= 1000000000))
        && (!('a' in d) || (d.a is int && d.a >= 0 && d.a <= 10000))
        && (!('g' in d) || (d.g is string && d.g.size() <= 200))
        && d.t == request.time;
    }
    // Eigene Freundesliste (nur der Besitzer sieht und ändert sie): fid = Konto-Kennung des Freundes
    match /friends/{uid}/f/{fid} {
      allow get, delete: if isOwner(uid);
      allow list: if isOwner(uid) && request.query.limit <= 100;
      allow create, update: if isOwner(uid) && fid != uid && fid.size() <= 128
        && request.resource.data.keys().hasOnly(['n', 't']) && request.resource.data.n is string && request.resource.data.n.size() <= 20 && request.resource.data.t is int;
    }
    // Einladungen „Lass uns spielen“: in den Posteingang eines Spielers mit Profil, höchstens eine alle 10 Sekunden je Absender, nur Spielkennung und Name (kein Freitext)
    match /invites/{uid}/i/{iid} {
      allow get, delete: if isOwner(uid);
      allow list: if isOwner(uid) && request.query.limit <= 20;
      allow create: if signedIn() && request.auth.uid != uid
        && exists(/databases/$(database)/documents/profiles/$(uid))
        && request.resource.data.keys().hasOnly(['f', 'n', 'g', 't']) && request.resource.data.keys().hasAll(['f', 'n', 'g', 't'])
        && request.resource.data.f == request.auth.uid
        && request.resource.data.n is string && request.resource.data.n.size() >= 2 && request.resource.data.n.size() <= 20
        && request.resource.data.g is string && request.resource.data.g.size() >= 1 && request.resource.data.g.size() <= 40
        && request.resource.data.t == request.time
        && !exists(/databases/$(database)/documents/chat_ban/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/invite_last/$(request.auth.uid)).data.t == request.time;
    }
    match /invite_last/{uid} {
      allow create: if isOwner(uid) && request.resource.data.keys().hasOnly(['t']) && request.resource.data.t == request.time;
      allow update: if isOwner(uid) && request.resource.data.keys().hasOnly(['t']) && request.resource.data.t == request.time
        && request.time > resource.data.t + duration.value(10, 's');
      allow read, delete: if false;
    }

    // ---------- Online-Kopplung aller Spiele (cloud/fire-peer.js) ----------
    // Firebase vermittelt nur den Verbindungsaufbau (WebRTC-Angebot/Antwort), gespielt wird direkt Gerät zu Gerät.
    // p2p/<Kennung> gehört dem Gastgeber (h = uid, t = Lebenszeichen alle 5 min); verwaist nach 15 min, dann darf ein anderer sie übernehmen.
    // Angebote liegen unter p2p/<Kennung>/in_<Gastgeber-uid>/<Gast-uid>_<Zufall>: nur der Gastgeber listet sie (ohne Zusatz-Lesezugriff)
    // und trägt die Antwort ein, der Gast liest nur sein eigenes Angebot. Kein Auflisten der Räume.
    function p2pHostDoc(d) {
      return d.keys().hasOnly(['h', 't']) && d.h == request.auth.uid && d.t == request.time;
    }
    match /p2p/{id} {
      allow get: if signedIn();
      allow create: if signedIn() && id.matches('^[A-Za-z0-9_-]{3,64}$') && p2pHostDoc(request.resource.data);
      allow update: if signedIn() && p2pHostDoc(request.resource.data)
        && (resource.data.h == request.auth.uid || request.time > resource.data.t + duration.value(15, 'm'));
      allow delete: if signedIn() && resource.data.h == request.auth.uid;

      match /{box}/{rid} {
        allow get: if signedIn() && (box == 'in_' + request.auth.uid || rid.matches('^' + request.auth.uid + '_[a-z0-9]{4,20}$'));
        allow list: if signedIn() && box == 'in_' + request.auth.uid && request.query.limit <= 20;
        allow create: if signedIn() && rid.matches('^' + request.auth.uid + '_[a-z0-9]{4,20}$')
          && box == 'in_' + get(/databases/$(database)/documents/p2p/$(id)).data.h
          && request.resource.data.keys().hasOnly(['o', 'a', 'p', 'm', 'l', 't']) && request.resource.data.keys().hasAll(['o', 'a', 'p', 't'])
          && request.resource.data.o is string && request.resource.data.o.size() > 0 && request.resource.data.o.size() < 20000
          && request.resource.data.a == '' && request.resource.data.t == request.time
          && request.resource.data.p is string && request.resource.data.p.size() <= 64
          && (!('m' in request.resource.data) || (request.resource.data.m is string && request.resource.data.m.size() <= 2000))
          && (!('l' in request.resource.data) || (request.resource.data.l is string && request.resource.data.l.size() <= 40));
        allow update: if signedIn() && box == 'in_' + request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['a', 't'])
          && request.resource.data.a is string && request.resource.data.a.size() < 20000 && request.resource.data.t == request.time;
        allow delete: if signedIn() && (box == 'in_' + request.auth.uid || rid.matches('^' + request.auth.uid + '_[a-z0-9]{4,20}$'));
      }
    }
  }
}
