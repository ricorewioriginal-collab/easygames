rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Spielstände: Dokument-ID = SHA-256 des geheimen Codes (64 Hex-Zeichen). Kein Auflisten, kein Löschen.
    match /saves/{id} {
      allow get: if true;
      allow list, delete: if false;
      allow create, update: if id.matches('[0-9a-f]{64}')
        && request.resource.data.keys().hasOnly(['d', 't'])
        && request.resource.data.d is string
        && request.resource.data.d.size() < 100000;
    }
  }
}
