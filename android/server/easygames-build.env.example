# /etc/easygames-build.env – Einstellungen für den easygames-Server-Job (wird von install.sh angelegt)
BRANCH=main
REPO_DIR=/opt/easygames
STATE_DIR=/var/lib/easygames-build
OUT_DIR=/var/www/easygames-app
ANDROID_HOME=/opt/android-sdk
# Release-Signatur (Keystore NIEMALS ins Repo und unbedingt sichern – ohne ihn sind keine Updates der installierten App möglich)
KEYSTORE_PATH=/var/lib/easygames-build/release.jks
KEYSTORE_PASSWORD=
KEY_ALIAS=easygames
KEY_PASSWORD=
# Manifest nach GitHub pushen (braucht Deploy-Key mit Schreibrecht). 0 = nur lokal berechnen
MANIFEST_PUSH=1
GIT_SSH_COMMAND="ssh -i /var/lib/easygames-build/.ssh/id_ed25519 -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new"
# optional: neues APK auch ohne Änderung nach X Tagen bauen (frischer Start-Inhalt im APK)
REBUILD_DAYS=30
# optional: apk (Standard) oder aab
FORMAT=apk
# optional: Adresse, von der die App Inhalte lädt (Standard: GitHub raw dieses Repos)
#SYNC_BASE=https://raw.githubusercontent.com/ricorewioriginal-collab/easygames/main/
# optional: Anwendungs-ID der App
#APP_ID=de.ricorewi.easygames
# optional: Benachrichtigung per POST (z. B. Slack/Discord/ntfy-kompatible URL), Feld "text"
#NOTIFY_URL=
# optional: APK automatisch auf der RicoReWi-Radio-Webseite bereitstellen (Ordner "downloads" im Live-Webroot, siehe android/server/publish-setup.sh).
# Danach liegen dort easygames-Developer.apk und easygames-latest.json; leer = nicht bereitstellen
#PUBLISH_DIR=/var/www/ricorewi-radio.de/downloads
#PUBLISH_NAME=easygames-Developer
