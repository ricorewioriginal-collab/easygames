# /etc/riftzone.env – Einstellungen des RIFTZONE-Servers
PORT=2610
HOST=127.0.0.1
# Webseiten, die verbinden dürfen (Komma-getrennt). Leer = alle (nur zum Testen!)
ALLOWED_ORIGINS=https://ricorewioriginal-collab.github.io
DATA_DIR=/opt/riftzone/data
# Teilnehmer pro öffentlichem Match (Menschen + Bots)
PUBLIC_MATCH_SIZE=100
# Sekunden Wartezeit, bevor ein öffentliches Match mit Bots aufgefüllt startet
QUEUE_WAIT=25
# Gleichzeitige Matches (je Match ~1 CPU-Kern bei 100 Teilnehmern ist großzügig gerechnet)
MAX_MATCHES=6
# Zustandspakete pro Tick (2 = 15 Hz)
SNAPSHOT_EVERY=2
BOT_SKILL=1
# Optional: gebautes Spiel gleich mit ausliefern (dann ist kein GitHub Pages nötig)
# STATIC_DIR=/opt/riftzone/app
