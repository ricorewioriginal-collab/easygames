# nginx: WebSocket-Weiterleitung für RIFTZONE (TLS z. B. per certbot)
server {
    listen 443 ssl http2;
    server_name riftzone.example.de;
    # ssl_certificate /etc/letsencrypt/live/riftzone.example.de/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/riftzone.example.de/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:2610;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }
}
