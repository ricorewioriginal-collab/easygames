{
  "name": "riftzone",
  "version": "1.0.0",
  "private": true,
  "description": "RIFTZONE – 3D-Third-Person-Battle-Royale für Browser und Handy mit Bots, Bauen, Fahrzeugen und eigenem Multiplayer-Server (TypeScript, Three.js, WebSocket).",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "npm run typecheck && vite build --config vite.config.ts",
    "build:esbuild": "npm run typecheck && node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "server": "tsx --tsconfig tsconfig.server.json server/src/index.ts",
    "server:build": "esbuild server/src/index.ts --bundle --platform=node --format=esm --packages=external --target=node20 --outfile=server/dist/server.mjs",
    "server:start": "node server/dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node e2e/smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build:esbuild && npm run test:e2e",
    "prebuild": "tsx scripts/gen-heightmap.ts",
    "predev": "tsx scripts/gen-heightmap.ts"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "three": "0.180.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/three": "0.180.0",
    "esbuild": "0.28.2",
    "playwright": "1.56.1",
    "tsx": "4.19.2",
    "typescript": "6.0.3",
    "vite": "7.1.12"
  }
}
