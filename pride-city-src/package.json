{
  "name": "pride-city",
  "version": "0.1.0",
  "private": true,
  "description": "Pride City – Ein Leben in allen Farben. Queere 3D-Lebenssimulation (Relaunch von Gay Life!), Vite + TypeScript + Three.js.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/fetch-assets.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:easygames": "npm run build && node scripts/publish.mjs",
    "assets": "node scripts/fetch-assets.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.37.1",
    "@babylonjs/loaders": "^9.37.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "fbx2gltf": "^0.9.7-p1",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
