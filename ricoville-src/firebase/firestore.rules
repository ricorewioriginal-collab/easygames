rules_version = '2';
// ENTWURF für spätere Nachbarn-Funktionen von RicoVille. Nicht ausgerollt, nicht gegen echte Daten getestet.
// Grundsatz: Clients dürfen nur eigene Daten schreiben; alles, was Werte anderer verändert (Besuche, Geschenke),
// läuft über Cloud Functions mit Admin-Rechten auf dem Server, nie direkt aus dem Browser.
service cloud.firestore {
  match /databases/{db}/documents {
    // Öffentliche Kurzansicht einer Stadt (für Besuche): nur der Besitzer schreibt, angemeldete Spieler lesen.
    match /ricoville_public/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'level', 'pop', 'crest', 'updatedAt', 'layout'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.level is int && request.resource.data.level >= 1 && request.resource.data.level <= 200
        && request.resource.data.layout is string && request.resource.data.layout.size() <= 60000;
    }
    // Nachbarschaftsanfragen: nur über Cloud Functions (Admin-SDK umgeht diese Regeln).
    match /ricoville_neighbors/{uid}/{doc=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // Geschenke/Hilfe: nur Server schreibt, Empfänger liest.
    match /ricoville_gifts/{uid}/{doc=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
